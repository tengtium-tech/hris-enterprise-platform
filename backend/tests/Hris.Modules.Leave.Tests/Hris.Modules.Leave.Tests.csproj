<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Modules.Leave.Tests
    Phase 3 (Workforce Management) Sprint 5, per IMPLEMENTATION-PLAN.md.

    docs/09-testing/unit-and-integration-testing.md Section 2: unit tests cover the
    Domain layer, constructing aggregates directly with no infrastructure — the
    identical scope every prior module's own test project already establishes.
    Application-layer tests dispatch through the real Hris.Testing.TenantIsolation
    harness (HEP-111) once this module's own command/query handlers exist, per
    unit-and-integration-testing.md Section 3.1 ("An in-memory provider is not
    acceptable") — the same pattern Attendance (the first module built after that
    harness existed) already establishes, rather than the mocked-repository pattern
    every earlier module used.

    Leave is not one of NFR-MT-001's three named 95%-floor areas (payroll, statutory
    calculation, authorization). This project targets the platform's own general 80%
    floor.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Modules.Leave.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this solution states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Hris.Modules.Leave\Hris.Modules.Leave.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <ProjectReference Include="..\Hris.Testing.TenantIsolation\Hris.Testing.TenantIsolation.csproj" />
  </ItemGroup>

</Project>
