<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Foundation.Entitlement.Tests
    docs/09-testing/unit-and-integration-testing.md Section 2: unit tests cover the
    Domain layer directly and, per coding-standards.md, this framework's own
    Application-layer query handlers too. No fake/substitute repository package is
    referenced here, since this framework has no repository of its own to fake:
    every handler under test reads only the two static, in-memory tables
    (ProcessPackCatalog, EditionDefaultPackComposition) its own Domain layer already
    owns, per entitlement-framework.md's own Scope section.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Foundation.Entitlement.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this repository states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Entitlement\Hris.Foundation.Entitlement.csproj" />
  </ItemGroup>

</Project>
