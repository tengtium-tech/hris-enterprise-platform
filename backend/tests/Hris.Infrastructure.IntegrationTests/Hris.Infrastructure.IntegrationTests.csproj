<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Infrastructure.IntegrationTests
    docs/09-testing/unit-and-integration-testing.md 3.1: "Integration tests cover
    command handlers, query handlers, repositories, transactions, and event
    publication, executing against a real PostgreSQL instance provided by
    Testcontainers... An in-memory provider is not acceptable."
    ci-cd-pipeline.md: "Integration tests run against a real PostgreSQL instance via
    Testcontainers... the PR Pipeline provisions this container as part of the job,
    discarding it afterward."

    First project of this kind in the repository. HEP-38 named the specific gap
    that created it (EF Core's own LINQ translation of a Value Object's overloaded
    equality operator, compared through a HasConversion-mapped property, had never
    been checked against a real PostgreSQL instance) rather than a general push for
    integration coverage, which is its own separate, larger, and still-open item
    (HEP-33). Scope here stays intentionally narrow to that one class of query:
    every already-merged repository sharing the same "Property == valueObjectInstance"
    shape, not full command/query/persistence/transaction coverage per
    unit-and-integration-testing.md section 3.2, which HEP-33 owns.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Infrastructure.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent and
         reasoning Hris.CriticalRequirements.Tests.csproj's own header states for
         itself: descriptive underscore-separated test names
         (Method_Scenario_ExpectedBehavior) are this project's own deliberate
         naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- docs/09-testing's own stated integration-database choice: "Testcontainers
         with PostgreSQL." Provisions and discards a real, disposable Postgres
         container per test run: no persistent database, no docker-compose
         service, no manual setup step for CI or for a future contributor. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- PostgresContainerFixture builds an in-memory IConfiguration to hand
         AddHrisInfrastructure the Testcontainers-assigned connection string.
         Microsoft.Extensions.Configuration.Abstractions (already transitively
         available) declares the interfaces; this package supplies the concrete
         ConfigurationBuilder/AddInMemoryCollection implementation. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Configuration\Hris.Foundation.Configuration.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Localization\Hris.Foundation.Localization.csproj" />
  </ItemGroup>

</Project>
