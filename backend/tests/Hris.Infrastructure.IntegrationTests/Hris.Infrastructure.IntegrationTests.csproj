<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Infrastructure.IntegrationTests
    docs/09-testing/unit-and-integration-testing.md 3.1: "Integration tests cover
    command handlers, query handlers, repositories, transactions, and event
    publication, executing against a real PostgreSQL instance provided by
    Testcontainers... An in-memory provider is not acceptable."
    ci-cd-pipeline.md: "Integration tests run against a real PostgreSQL instance via
    Testcontainers... the PR Pipeline provisions this container as part of the job,
    discarding it afterward."

    First project of this kind in the repository, started under HEP-38 (Configuration,
    Localization) and extended to cover every other already-merged repository sharing
    the same "compare a converted property, or reach into an owned-type navigation,
    from a LINQ predicate" shape (RulesEngine, Audit, Identity, Events, Authorization).
    Scope stays intentionally narrow to that one class of query, not full
    command/query/persistence/transaction coverage per unit-and-integration-testing.md
    section 3.2, which HEP-33 owns as its own separate, larger, still-open item.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Infrastructure.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent and
         reasoning Hris.CriticalRequirements.Tests.csproj's own header states for
         itself: descriptive underscore-separated test names
         (Method_Scenario_ExpectedBehavior) are this project's own deliberate
         naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- docs/09-testing's own stated integration-database choice: "Testcontainers
         with PostgreSQL." Provisions and discards a real, disposable Postgres
         container per test run: no persistent database, no docker-compose
         service, no manual setup step for CI or for a future contributor. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- PostgresContainerFixture builds an in-memory IConfiguration to hand
         AddHrisInfrastructure the Testcontainers-assigned connection string.
         Microsoft.Extensions.Configuration.Abstractions (already transitively
         available) declares the interfaces; this package supplies the concrete
         ConfigurationBuilder/AddInMemoryCollection implementation. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- One ProjectReference per Sprint 3 Core Kernel framework this project's own
         tests exercise, every framework except Validation, which has no
         EF Core-mapped Aggregate of its own to test this way (see that framework's
         own csproj header: "no EF Core persistence of its own"). Mirrors
         Hris.Api's own Program.cs registration list, so PostgresContainerFixture's
         own AddXFramework() calls build the identical HrisDbContext model shape
         production does. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Configuration\Hris.Foundation.Configuration.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Logging\Hris.Foundation.Logging.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Identity\Hris.Foundation.Identity.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Events\Hris.Foundation.Events.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Authorization\Hris.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Audit\Hris.Foundation.Audit.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.RulesEngine\Hris.Foundation.RulesEngine.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Localization\Hris.Foundation.Localization.csproj" />
    <!-- Numbering Framework, added for NumberSeriesConcurrencyTests. Unlike the
         seven repositories above (all verifying a LINQ translation shape), this
         framework's own atomic-increment repository method needs a real database to
         verify a correctness property no LINQ-translation check covers: genuine
         concurrent-writer safety (CTR-DAT-001), which an in-process fake repository
         cannot exercise no matter how it is written. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Numbering\Hris.Foundation.Numbering.csproj" />
    <!-- Search Framework, added for IndexedDocumentSearchTests. Its own
         IIndexedDocumentRepository.SearchAsync is raw SQL against PostgreSQL's own
         native full-text search, not a LINQ predicate, so a fake repository would
         verify the C# call shape but not whether the actual WHERE clause really
         excludes another tenant's rows, the same "needs a real database" reasoning
         NumberSeriesConcurrencyTests already establishes for CTR-DAT-001, applied here
         to this framework's own explicitly-named CTR-ISO-001. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Search\Hris.Foundation.Search.csproj" />
  </ItemGroup>

</Project>
