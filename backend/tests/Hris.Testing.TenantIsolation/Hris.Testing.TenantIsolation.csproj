<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Testing.TenantIsolation
    Shared integration-test harness for tenant-isolation critical requirements.
    Provides a real PostgreSQL container (Testcontainers), full DI composition
    (all foundation frameworks + all merged modules), two canonical seeded tenants,
    and per-test transaction rollback for isolation.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Testing.TenantIsolation</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- This is a shared library consumed by Hris.CriticalRequirements.Tests — it has
         no [Fact]s of its own. Without Microsoft.NET.Test.Sdk it should never be picked
         up as a runnable test project, but referencing xunit directly (needed for
         IAsyncLifetime/IClassFixture<T>) is enough for `dotnet test Hris.sln` to try
         launching a standalone test host against it anyway. That host does not resolve
         Testcontainers' own transitive dependencies (BouncyCastle.Cryptography) the way
         a real test project's full Test SDK does, so CI fails on a project with zero
         tests to run. IsTestProject=false is the documented MSBuild property `dotnet
         test` checks before attempting to execute a project; it opts this one out of
         discovery entirely rather than working around a test host that should never
         have started. -->
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
