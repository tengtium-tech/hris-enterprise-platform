    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Application\Hris.Application.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Audit\Hris.Foundation.Audit.csproj" />
