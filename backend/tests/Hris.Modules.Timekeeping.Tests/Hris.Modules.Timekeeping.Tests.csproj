<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Modules.Timekeeping.Tests
    Phase 3 (Workforce Management) Sprint 3, per IMPLEMENTATION-PLAN.md.

    docs/09-testing/unit-and-integration-testing.md Section 2: unit tests cover the
    Domain layer, constructing aggregates directly with no infrastructure, the
    identical scope every prior module's own test project already establishes. One
    exception: Infrastructure/Persistence/ builds a real HrisDbContext against a
    fake (never-connected) Npgsql connection string purely to force EF Core's own
    model validation, the same Docker-free technique that caught real modeling bugs
    while building Organization, Administration, and Workflow.

    TK-001 through TK-003 get deliberately heavy coverage. They are this module's
    security core in the sense its own README uses the term: not permissions, but
    properties nothing may violate. A violation does not surface as an error, it
    surfaces two phases downstream as payroll that is internally consistent,
    plausible, and wrong, so the tests assert the historical version is returned
    unchanged rather than merely that a revision succeeded.

    Timekeeping is not one of NFR-MT-001's three named 95%-floor areas (payroll,
    statutory calculation, authorization). This project targets the platform's own
    general 80% floor, built from day one per this project's own Coding Phase
    traceability rule.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Modules.Timekeeping.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this solution states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Hris.Modules.Timekeeping\Hris.Modules.Timekeeping.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
  </ItemGroup>

</Project>
