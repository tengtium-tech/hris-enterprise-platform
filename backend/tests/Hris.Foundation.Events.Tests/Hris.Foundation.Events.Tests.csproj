<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Foundation.Events.Tests
    First test project for Event Framework (Sprint 3). This framework's own
    Domain/Application layers had no dedicated unit test project of their own before
    this Sprint (their own query-translation-shaped correctness was instead covered
    incidentally inside Hris.Infrastructure.IntegrationTests' own
    RepositoryQueryTranslationTests.cs). Created now, scoped narrowly to the one new
    piece of behavior Sprint 9 (Logging & Monitoring, Operational Layer, HEP-89) adds
    to this framework: OutboxDispatchEnrichment's own trace/log-context propagation,
    not a general backfill of this framework's own pre-existing test debt, which is a
    separate concern from this Sprint's own stated scope.

    docs/09-testing/unit-and-integration-testing.md Section 2: unit tests cover the
    Domain/Infrastructure layer, constructing real objects directly with no database
    or hosting. OutboxDispatchEnrichment's own extraction (see that class's own
    remarks) makes this possible here without a real IHostedService or DbContext.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Foundation.Events.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this solution states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Events\Hris.Foundation.Events.csproj" />
  </ItemGroup>

</Project>
