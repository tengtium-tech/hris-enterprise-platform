<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Modules.Attendance.Tests
    Phase 3 (Workforce Management) Sprint 4, per IMPLEMENTATION-PLAN.md.

    docs/09-testing/unit-and-integration-testing.md Section 2: unit tests cover the
    Domain layer, constructing aggregates directly with no infrastructure, the
    identical scope every prior module's own test project already establishes.

    Started with AttendanceAdjustment (the two-phase approve/apply split AT-024
    governs) and AttendanceCalculationEngine (the fifteen-step pipeline) — this
    module's own docs name both as its most intricate logic, and the module shipped
    with no tests at all until this project existed, unlike every prior module.
    Domain/ now covers all six Aggregate Roots; Application/ tests command and query
    handlers against the real Hris.Testing.TenantIsolation harness (HEP-111) rather
    than NSubstitute doubles, per unit-and-integration-testing.md §3.1 ("An
    in-memory provider is not acceptable") — Attendance is the first module built
    after that harness existed, so it uses it from the start rather than repeating
    the mocked-repository pattern every earlier module used.

    Attendance is not one of NFR-MT-001's three named 95%-floor areas (payroll,
    statutory calculation, authorization). This project targets the platform's own
    general 80% floor.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Modules.Attendance.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this solution states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Hris.Modules.Attendance\Hris.Modules.Attendance.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <ProjectReference Include="..\Hris.Testing.TenantIsolation\Hris.Testing.TenantIsolation.csproj" />
  </ItemGroup>

</Project>
