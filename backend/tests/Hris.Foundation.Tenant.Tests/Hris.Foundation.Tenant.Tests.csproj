<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Foundation.Tenant.Tests
    docs/09-testing/unit-and-integration-testing.md Section 2: unit tests cover the
    Domain layer only, constructing aggregates and Value Objects directly with no
    infrastructure; extended here to this framework's own Application-layer command/
    query handlers too, constructed against fake/substitute repositories, never a
    real HrisDbContext, the identical scope Hris.Foundation.Authorization.Tests
    already establishes.

    Tenant Framework, unlike Authorization Framework, is not one of NFR-MT-001's
    three named 95%-floor areas (payroll, statutory calculation, authorization),
    docs/00-project/non-functional-requirements.md. This project targets the
    platform's own general 80% floor, not Authorization's own elevated 95%; built
    from day one per CLAUDE.md's own "Coding Phase" traceability rule, rather than
    deferred as HEP-52-style backfill the way every other Sprint 3 framework's own
    tests were.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Foundation.Tenant.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this solution states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Tenant\Hris.Foundation.Tenant.csproj" />
    <!-- Identity Framework: ActivateTenantCommand's own ActivatedBy field is a
         UserAccountId, and its handler tests need to construct one. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Foundation.Identity\Hris.Foundation.Identity.csproj" />
  </ItemGroup>

</Project>
