<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Application.Tests
    First test project for Hris.Application itself (Sprint 3's own shared kernel
    project): its own ValidationBehavior/TransactionBehavior were previously
    exercised only indirectly, through each framework's own Application-layer tests.
    Sprint 7 (API Platform) adds real, standalone logic to this project for the
    first time (Pagination/PageRequest, PagedResult, SortRequest), per
    api-standards.md's own Pagination, Filtering, and Sorting section, logic with
    no framework of its own to host its tests, so it gets its own test project here.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Application.Tests</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- CA1707 suppressed in this project only, the identical precedent every other
         test project in this repository states for itself: descriptive
         underscore-separated test names (Rule_Condition) are this project's own
         deliberate naming convention, not a defect. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- coverlet.msbuild: this project does not exercise the rest of
         Hris.Application (ValidationBehavior/TransactionBehavior are already
         exercised indirectly by every framework's own Application-layer tests), so
         a plain coverage run understates this project's own real responsibility.
         Scope collection with -p:Include=[Hris.Application]Hris.Application.Pagination.*
         to see this project's own actual floor (100%/91.66%/100% at last check), the
         identical /p:Include scoping technique Hris.Foundation.Authorization.Tests.csproj
         already documents for its own narrower-than-whole-project need. -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\Hris.Application\Hris.Application.csproj" />
  </ItemGroup>

</Project>
