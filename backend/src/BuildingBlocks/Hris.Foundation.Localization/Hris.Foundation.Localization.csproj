<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hris.Foundation.Localization
    Sprint 3 (Core Kernel) scope, per IMPLEMENTATION-PLAN.md Phase 1.
    Source specification: docs/03-foundation/localization-framework.md
    Domain layer implemented against that document; see Domain/ for the per-class
    citations. Application/Infrastructure layers added in a follow-on pass; see
    Application/ and Infrastructure/ for their own citations. The last of the nine
    Sprint 3 Core Kernel frameworks built, per IMPLEMENTATION-PLAN.md's own bootstrap
    order: nothing else in the kernel lists Localization as its own upstream
    dependency, so it carries no "sibling not built yet" gap the way Validation's own
    Localization dependency did.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Foundation.Localization</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MediatR/FluentValidation: this framework's own commands/queries and their
         validators, the identical shape every other CQRS-shaped Sprint 3 framework
         already establishes, unlike Logging/Validation Frameworks; this one has
         real Aggregate Roots (CountryConfiguration, TranslationEntry) with their own
         repositories, not a plain service facade. -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hris.SharedKernel\Hris.SharedKernel.csproj" />
    <ProjectReference Include="..\Hris.Application\Hris.Application.csproj" />
    <ProjectReference Include="..\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <!-- Identity Framework already exists: referenced concretely for
         UserAccountId, who last changed a translation or country configuration
         (CTR-ARC-002). Not one of this framework's own stated Upstream
         Dependencies, but a strictly smaller, already-built addition in the same
         spirit as every other framework's actor-tracking fields this Sprint. -->
    <ProjectReference Include="..\Hris.Foundation.Identity\Hris.Foundation.Identity.csproj" />
    <!-- Configuration Framework: one of this framework's own stated Upstream
         Dependencies, and the one concretely wired; ResolveTranslationQuery
         resolves its own configurable fallback-locale chain through it, per
         localization-framework.md's own "Fallback behavior should be
         configurable." -->
    <ProjectReference Include="..\Hris.Foundation.Configuration\Hris.Foundation.Configuration.csproj" />
  </ItemGroup>

</Project>
