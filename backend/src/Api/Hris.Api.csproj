<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Hris.Api
    The platform's single deployable ASP.NET Core project, per ADR-0001 and
    docs/08-devops/containerization.md's "Image Strategy": "One application image,
    built from backend/'s single deployable ASP.NET Core project, containing every
    business module compiled into it." Every Foundation framework and every business
    module's Presentation layer registers into this host; this project itself should
    stay thin (Program.cs wiring, health endpoints, middleware pipeline) — business
    logic belongs in the Application/Domain layers of the module or framework it
    concerns, per docs/08-devops/coding-standards.md's Presentation Layer convention.
  -->

  <PropertyGroup>
    <RootNamespace>Hris.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sprint 3 kernel frameworks. Module ProjectReferences are added as each
         module's own Sprint begins (docs/04-modules/README.md's build order,
         reflected in IMPLEMENTATION-PLAN.md) — do not add a module reference here
         ahead of its own Sprint. -->
    <ProjectReference Include="..\BuildingBlocks\Hris.SharedKernel\Hris.SharedKernel.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Application\Hris.Application.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Infrastructure\Hris.Infrastructure.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Configuration\Hris.Foundation.Configuration.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Logging\Hris.Foundation.Logging.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Identity\Hris.Foundation.Identity.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Events\Hris.Foundation.Events.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Authorization\Hris.Foundation.Authorization.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Audit\Hris.Foundation.Audit.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.RulesEngine\Hris.Foundation.RulesEngine.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Validation\Hris.Foundation.Validation.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Localization\Hris.Foundation.Localization.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Tenant\Hris.Foundation.Tenant.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Extension\Hris.Foundation.Extension.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.FileStorage\Hris.Foundation.FileStorage.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Numbering\Hris.Foundation.Numbering.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Search\Hris.Foundation.Search.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Scheduling\Hris.Foundation.Scheduling.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.JobProcessing\Hris.Foundation.JobProcessing.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.StatutoryReferenceData\Hris.Foundation.StatutoryReferenceData.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.WorkflowEngine\Hris.Foundation.WorkflowEngine.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Notification\Hris.Foundation.Notification.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Entitlement\Hris.Foundation.Entitlement.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Caching\Hris.Foundation.Caching.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.DocumentManagement\Hris.Foundation.DocumentManagement.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Hris.Foundation.Integration\Hris.Foundation.Integration.csproj" />
    <!-- Phase 2 (Core HR) Sprint 1, the platform's first business module. -->
    <ProjectReference Include="..\Modules\Hris.Modules.Organization\Hris.Modules.Organization.csproj" />
    <!-- Phase 2 (Core HR) Sprint 2. -->
    <ProjectReference Include="..\Modules\Hris.Modules.Position\Hris.Modules.Position.csproj" />
    <ProjectReference Include="..\Modules\Hris.Modules.Employment\Hris.Modules.Employment.csproj" />
    <!-- Phase 2 (Core HR) Sprint 4, last of Phase 2's four Sprints. -->
    <ProjectReference Include="..\Modules\Hris.Modules.Employee\Hris.Modules.Employee.csproj" />
    <!-- Phase 3 (Workforce Management) Sprint 1, first module of Phase 3. -->
    <ProjectReference Include="..\Modules\Hris.Modules.Administration\Hris.Modules.Administration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddDbContextCheck<HrisDbContext> in Program.cs, backing the /health/ready
         "ready"-tagged database connectivity check. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.4" />
    <!-- Sprint 9 (Logging & Monitoring, Operational Layer), monitoring-and-alerting.md's
         own Distributed Tracing section (NFR-OB-002), per technology-stack.md's own
         Monitoring & Observability table naming OpenTelemetry as this platform's own
         tracing technology. Instrumentation.AspNetCore/Http trace every incoming
         request and outbound HttpClient call; Exporter.Console is this Sprint's one
         configured exporter, the identical "one sink for now, a production
         destination is a config change later" choice Serilog's own Console sink
         already makes below. environment-strategy.md governs adding a real trace
         backend (Grafana Tempo, per technology-stack.md) later without this code
         changing. No EF Core/Npgsql instrumentation package yet: the current stable
         OpenTelemetry instrumentation for Npgsql ships as part of Npgsql itself
         (Npgsql.OpenTelemetry, not an OpenTelemetry.* package), a separate,
         database-driver-specific integration this Sprint's own build does not add,
         stated here explicitly rather than left implicit. -->
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <!-- Serilog host bootstrap for Logging Framework's SerilogLogSink (see that
         class's own remarks) — Serilog.Sinks.Console is this Sprint's one configured
         sink, since no log-aggregation platform is chosen yet; environment-strategy.md
         governs adding a production sink (e.g. a structured file or collector sink)
         later without this framework's own code changing. -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
